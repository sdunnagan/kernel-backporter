class ProvenanceIndex:
    """Map upstream identities to commits in one downstream history."""

    def __init__(self, git: Git, ref: str, label: str, debug: bool = False):
        self.git = git
        self.ref = ref
        self.label = label
        self.debug = debug
        self.exact: set[str] = set()
        self.refs: dict[str, tuple[str, str]] = {}
        self._build()

    def _index_record(self, sha: str, body: str) -> None:
        sha = sha.strip().lower()
        if not sha:
            return
        self.exact.add(sha)
        for regex, label in (
            (CHERRY_PICK_RE, "cherry-picked-from"),
            (UPSTREAM_COMMIT_RE, "upstream-commit"),
            (STABLE_UPSTREAM_RE, "stable-upstream"),
        ):
            for upstream_sha in regex.findall(body):
                self.refs.setdefault(upstream_sha.lower(), (sha, label))
        # RHEL backports often preserve an indented/default git-show header
        # containing a standalone "commit <upstream sha>" line.
        for upstream_sha in EMBEDDED_COMMIT_RE.findall(body):
            self.refs.setdefault(upstream_sha.lower(), (sha, "embedded-commit"))

    def _build(self) -> None:
        # Do not collect the entire downstream history in one Python string.
        # Kernel commit bodies can make that hundreds of MB, and split("\0")
        # temporarily duplicates much of it. Stream NUL-delimited SHA/body pairs
        # instead so memory use stays bounded by roughly one chunk/commit body.
        cmd = [
            "git", "log", "--no-merges", "--format=%H%x00%B%x00", self.ref
        ]
        proc = subprocess.Popen(
            cmd, cwd=str(self.git.cwd), stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, text=True, encoding="utf-8",
            errors="surrogateescape",
        )
        assert proc.stdout is not None

        pending = ""
        fields: list[str] = []
        count = 0
        while True:
            chunk = proc.stdout.read(65536)
            if not chunk:
                break
            pending += chunk
            parts = pending.split("\0")
            pending = parts.pop()
            for field in parts:
                fields.append(field)
                if len(fields) == 2:
                    self._index_record(fields[0], fields[1])
                    count += 1
                    fields.clear()

        proc.stdout.close()
        stderr = proc.stderr.read() if proc.stderr else ""
        if proc.stderr:
            proc.stderr.close()
        rc = proc.wait()
        if rc:
            raise KBError(
                f"failed to index downstream provenance for {self.label}: "
                f"{stderr.strip()}"
            )
        if fields or pending.strip():
            raise KBError(
                f"malformed git log stream while indexing downstream provenance "
                f"for {self.label}"
            )
        print(f"  indexed {count} non-merge commits from {self.label}")

    def match_aliases(self, aliases: Iterable[str]) -> IdentityMatch:
        for alias in aliases:
            alias = alias.lower()
            if alias in self.exact:
                return IdentityMatch(True, alias, "exact-sha", self.label, "high")
            if alias in self.refs:
                ds, method = self.refs[alias]
                conf = "high" if method != "embedded-commit" else "medium-high"
                return IdentityMatch(True, ds, method, self.label, conf)
        return IdentityMatch()


class ReferenceManager:
    OFFICIAL_STABLE = "https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git"
    OFFICIAL_NEXT = "https://git.kernel.org/pub/scm/linux/kernel/git/next/linux-next.git"

    def __init__(self, args: argparse.Namespace, work_git: Git):
        self.args = args
        self.work_git = work_git
        self.root = Path(args.reference_root).expanduser().resolve()
        self.upstream_path = self.root / ("linux-stable" if args.linux_repo == "stable" else "linux-next")
        self.downstream_path = self.root / "cs10"

    def _discover_upstream_url(self) -> str:
        if self.args.upstream_url:
            return self.args.upstream_url
        remote = "linux-stable" if self.args.linux_repo == "stable" else "linux-next"
        return self.work_git.remote_url(remote) or (
            self.OFFICIAL_STABLE if self.args.linux_repo == "stable" else self.OFFICIAL_NEXT
        )

    def _discover_downstream_url(self) -> str:
        if self.args.downstream_url:
            return self.args.downstream_url
        candidates = [self.args.downstream_remote, "cs10", "origin"]
        for remote in dict.fromkeys(x for x in candidates if x):
            url = self.work_git.remote_url(remote)
            if url:
                return url
        raise KBError(
            "cannot determine downstream repository URL; pass --downstream-url "
            "or configure a cs10/origin remote"
        )

    def _clone_if_missing(self, path: Path, url: str, label: str) -> None:
        if (path / ".git").exists():
            return
        if path.exists() and any(path.iterdir()):
            raise KBError(f"reference path exists but is not a git clone: {path}")
        print(f"Creating {label} reference repository: {path}")
        cp = subprocess.run(["git", "clone", url, str(path)], text=True)
        if cp.returncode:
            raise KBError(f"failed to clone {label} reference from {url}")

    def prepare(self) -> tuple[Git, Git, str, str]:
        self.root.mkdir(parents=True, exist_ok=True)
        upstream_url = self._discover_upstream_url()
        downstream_url = self._discover_downstream_url()
        self._clone_if_missing(self.upstream_path, upstream_url, "upstream")
        self._clone_if_missing(self.downstream_path, downstream_url, "downstream")

        ug = Git(self.upstream_path, self.args.debug)
        dg = Git(self.downstream_path, self.args.debug)

        if not self.args.skip_refresh:
            print(f"Refreshing upstream reference:   {self.upstream_path}")
            ug.run(["fetch", "--prune", "--tags", "origin"])
            print(f"Refreshing current CS10 reference: {self.downstream_path}")
            dg.run(["fetch", "--prune", "origin", self.args.downstream_branch])
            dg.run(["checkout", "-B", self.args.downstream_branch,
                    f"origin/{self.args.downstream_branch}"])
            dg.run(["reset", "--hard", f"origin/{self.args.downstream_branch}"])
            dg.run(["clean", "-fd"])
        else:
            print("Reference refresh skipped by request.")

        # In single-commit mode, use the fetched upstream default branch as
        # the analysis boundary unless the user explicitly pins --target.
        # The local HEAD of a reference clone may be stale after git fetch;
        # origin/HEAD tracks the upstream branch without moving that checkout.
        if self.args.target is None:
            if self.args.plan:
                raise KBError("plan mode requires a target from its validated JSON plan")
            remote_head = "refs/remotes/origin/HEAD"
            if ug.ok(["rev-parse", "--verify", f"{remote_head}^{{commit}}"]):
                self.args.target = remote_head
            else:
                # Local repositories may have no origin/HEAD (for example,
                # user-managed references used with --skip-refresh).
                self.args.target = "HEAD"
                print("Warning: upstream origin/HEAD is unavailable; using local HEAD. "
                      "Use --target to pin the analysis boundary.", file=sys.stderr)

        target = ug.rev_parse(self.args.target)
        downstream = dg.rev_parse(self.args.downstream_branch)
        return ug, dg, target, downstream


class KernelBackporter:
    def __init__(self, args: argparse.Namespace):
        self.args = args
        repo = args.repo or default_downstream_repo()
        self.repo = Path(repo).expanduser().resolve()
        self.work_git = Git(self.repo, args.debug)
        if not (self.repo / ".git").exists() and not self.work_git.ok(["rev-parse", "--git-dir"]):
            raise KBError(f"not a git repository: {self.repo}")
        self.start_head = self.work_git.rev_parse("HEAD")
        self.refs = ReferenceManager(args, self.work_git)
        self.upstream: Git
        self.current_ds: Git
        self.target: str
        self.current_ds_head: str
        self.work_index: ProvenanceIndex
        self.current_index: ProvenanceIndex
        self.requested: str = ""
        self.plan: set[str] = set()
        self.auto_added: set[str] = set()
        self.reason_map: dict[str, list[str]] = collections.defaultdict(list)
        self._aliases: dict[str, set[str]] = {}
        self._subject: dict[str, str] = {}
        self._body: dict[str, str] = {}
        self._files: dict[str, list[str]] = {}
        self._candidate_seen: set[str] = set()
        self._patch_id_cache: dict[tuple[str, str], str | None] = {}
        self._patch_scan_cache: dict[tuple[str, str, tuple[str, ...]], dict[str, str]] = {}
        self.latest_conflict: ConflictInfo | None = None
        self.outdated_dependencies: list[tuple[str, IdentityMatch]] = []
        self.report_root = Path(args.report_dir).expanduser().resolve()
        self.diff_dir = Path(args.diff_dir).expanduser().resolve()
        self.patch_dir = Path(args.patch_dir).expanduser().resolve()

    def prepare(self) -> None:
        if not self.work_git.status_clean():
            raise KBError(
                "working tree is not clean. Commit/stash changes before running kernel-backporter; "
                "the orchestrator will not guess which local edits are sacred."
            )
        self.upstream, self.current_ds, self.target, self.current_ds_head = self.refs.prepare()
        self.requested = self.upstream.rev_parse(self.args.commit)
        if not self.upstream.is_ancestor(self.requested, self.target):
            raise KBError(
                f"requested commit {self.requested} is not an ancestor of target {self.args.target} "
                f"({self.target})"
            )

        print("\nReference repositories:")
        print(f"  upstream:   {self.refs.upstream_path}")
        print(f"  downstream: {self.refs.downstream_path}")
        print(f"  target:     {self.args.target} -> {self.target}")
        print(f"  CS10 today: {self.current_ds_head}")
        print(f"  work HEAD:  {self.start_head}")

        print("\nIndexing downstream provenance...")
        self.work_index = ProvenanceIndex(self.work_git, "HEAD", "working-tree", self.args.debug)
        self.current_index = ProvenanceIndex(
            self.current_ds, self.args.downstream_branch, "current-downstream", self.args.debug
        )

    def subject(self, sha: str) -> str:
        if sha not in self._subject:
            self._subject[sha] = self.upstream.subject(sha)
        return self._subject[sha]

    def body(self, sha: str) -> str:
        if sha not in self._body:
            self._body[sha] = self.upstream.body(sha)
        return self._body[sha]

    def files(self, sha: str) -> list[str]:
        if sha not in self._files:
            self._files[sha] = self.upstream.changed_files(sha)
        return self._files[sha]

    def aliases(self, sha: str) -> set[str]:
        if sha in self._aliases:
            return self._aliases[sha]
        result = {sha.lower()}
        body = self.body(sha)
        for regex in (UPSTREAM_COMMIT_RE, STABLE_UPSTREAM_RE):
            result.update(x.lower() for x in regex.findall(body))
        self._aliases[sha] = result
        return result

    def _patch_id(self, git: Git, sha: str) -> str | None:
        key = (str(git.cwd), sha)
        if key in self._patch_id_cache:
            return self._patch_id_cache[key]
        if len(git.parents(sha)) != 1:
            self._patch_id_cache[key] = None
            return None
        patch = git.run(["show", "--pretty=format:", "--binary", sha], check=False)
        if not patch.strip():
            self._patch_id_cache[key] = None
            return None
        cp = subprocess.run(
            ["git", "patch-id", "--stable"], cwd=str(git.cwd), input=patch,
            text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        )
        pid = cp.stdout.split()[0] if cp.returncode == 0 and cp.stdout.split() else None
        self._patch_id_cache[key] = pid
        return pid

    def _patch_id_map(self, git: Git, ref: str, files: list[str]) -> dict[str, str]:
        key = (str(git.cwd), ref, tuple(sorted(files)))
        if key in self._patch_scan_cache:
            return self._patch_scan_cache[key]
        cmd = [
            "git", "log", "--no-merges", "-p", "--binary",
            "--pretty=format:commit %H", ref,
        ]
        if files:
            cmd.extend(["--", *files])
        log_cp = subprocess.Popen(
            cmd, cwd=str(git.cwd), stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            text=True, encoding="utf-8", errors="surrogateescape",
        )
        assert log_cp.stdout is not None
        pid_cp = subprocess.run(
            ["git", "patch-id", "--stable"], cwd=str(git.cwd), stdin=log_cp.stdout,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
            encoding="utf-8", errors="surrogateescape",
        )
        log_cp.stdout.close()
        log_stderr = log_cp.stderr.read() if log_cp.stderr else ""
        log_rc = log_cp.wait()
        if log_rc or pid_cp.returncode:
            if self.args.debug:
                print(
                    f"patch-id scan failed for {git.cwd}:{ref}: "
                    f"{log_stderr.strip()} {pid_cp.stderr.strip()}", file=sys.stderr
                )
            result: dict[str, str] = {}
        else:
            result = {}
            for line in pid_cp.stdout.splitlines():
                fields = line.split()
                if len(fields) >= 2:
                    result.setdefault(fields[0], fields[1])
        self._patch_scan_cache[key] = result
        return result

    def _match_with_patch_id(
        self, index: ProvenanceIndex, downstream_git: Git, downstream_ref: str,
        sha: str, source: str
    ) -> IdentityMatch:
        m = index.match_aliases(self.aliases(sha))
        if m.present or self.args.no_patch_id:
            return m
        pid = self._patch_id(self.upstream, sha)
        if not pid:
            return m
        mapping = self._patch_id_map(downstream_git, downstream_ref, self.files(sha))
        ds = mapping.get(pid)
        if ds:
            return IdentityMatch(True, ds, "patch-id", source, "high")
        return m

    def match_working(self, sha: str) -> IdentityMatch:
        return self._match_with_patch_id(
            self.work_index, self.work_git, "HEAD", sha, "working-tree"
        )

    def match_current(self, sha: str) -> IdentityMatch:
        return self._match_with_patch_id(
            self.current_index, self.current_ds, self.args.downstream_branch, sha,
            "current-downstream"
        )

    def resolve_short(self, short: str) -> str | None:
        out = self.upstream.run(["rev-parse", "--verify", f"{short}^{{commit}}"], check=False).strip()
        return out or None

    def fixes_targets(self, sha: str) -> list[str]:
        result: list[str] = []
        for short in FIXES_RE.findall(self.body(sha)):
            full = self.resolve_short(short)
            if full:
                result.append(full)
        return result

    def _simulation_clone(self) -> tuple[Path, Git]:
        root = Path(tempfile.mkdtemp(prefix="kernel-backporter-"))
        sim = root / "repo"
        cp = subprocess.run(
            ["git", "clone", "--shared", "--no-checkout", str(self.repo), str(sim)],
            text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        )
        if cp.returncode:
            shutil.rmtree(root, ignore_errors=True)
            raise KBError(f"failed to create simulation clone: {cp.stderr.strip()}")
        sg = Git(sim, self.args.debug)
        sg.run(["checkout", "--detach", self.start_head])
        return root, sg

    def ordered_plan(self, selected: set[str] | None = None) -> list[str]:
        selected = selected or self.plan
        if not selected:
            return []
        # Every automatically selected dependency must be an ancestor of the
        # requested commit.  Filter the requested commit's ancestry in topo order.
        revs = self.upstream.run([
            "rev-list", "--reverse", "--topo-order", self.requested
        ]).splitlines()
        return [x for x in revs if x in selected]

    def simulate(self, selected: set[str] | None = None, *, run_check: bool = False) -> SequenceResult:
        order = self.ordered_plan(selected)
        root, sg = self._simulation_clone()
        applied: list[str] = []
        try:
            for sha in order:
                sg.run(["fetch", "--no-tags", str(self.refs.upstream_path), sha])
                cp = sg._run_cp(["cherry-pick", "--no-commit", sha], check=False)
                if cp.returncode:
                    files = [x for x in sg.run([
                        "diff", "--name-only", "--diff-filter=U"
                    ], check=False).splitlines() if x]
                    conflict = ConflictInfo(sha, files, cp.stdout, cp.stderr)
                    return SequenceResult(False, applied, conflict)

                tree = sg.run(["write-tree"]).strip()
                env = {
                    **os.environ,
                    "GIT_AUTHOR_NAME": "kernel-backporter",
                    "GIT_AUTHOR_EMAIL": "kernel-backporter@example.invalid",
                    "GIT_COMMITTER_NAME": "kernel-backporter",
                    "GIT_COMMITTER_EMAIL": "kernel-backporter@example.invalid",
                }
                cp2 = subprocess.run(
                    ["git", "commit-tree", tree, "-p", "HEAD"], cwd=str(sg.cwd),
                    input=self.body(sha), text=True, stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE, env=env,
                )
                if cp2.returncode:
                    raise KBError(cp2.stderr.strip())
                sg.run(["reset", "--hard", cp2.stdout.strip()])
                applied.append(sha)

            if run_check and self.args.check_command:
                cp = subprocess.run(
                    self.args.check_command, cwd=str(sg.cwd), shell=True, text=True,
                    stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                )
                return SequenceResult(
                    cp.returncode == 0, applied, None,
                    check_rc=cp.returncode, check_output=cp.stdout,
                )
            return SequenceResult(True, applied)
        finally:
            shutil.rmtree(root, ignore_errors=True)

    def parse_hunks(self, sha: str, only_paths: set[str] | None = None) -> list[tuple[str, int, int, int, int, list[str]]]:
        parents = self.upstream.parents(sha)
        if len(parents) != 1:
            return []
        diff = self.upstream.run(["diff", "--unified=0", parents[0], sha, "--"])
        path: str | None = None
        current = None
        hunks = []
        for line in diff.splitlines():
            fm = DIFF_FILE_RE.match(line)
            if fm:
                path = fm.group(2)
                current = None
                continue
            hm = HUNK_RE.match(line)
            if hm and path and (only_paths is None or path in only_paths):
                current = [
                    path,
                    int(hm.group(1)), int(hm.group(2) or "1"),
                    int(hm.group(3)), int(hm.group(4) or "1"),
                    [],
                ]
                hunks.append(current)
                continue
            if current is not None and line.startswith("+") and not line.startswith("+++"):
                current[5].append(line[1:])
        return [tuple(x) for x in hunks]  # type: ignore[return-value]

    def blame_range(self, revision: str, path: str, start: int, end: int) -> collections.Counter[str]:
        if end < start or start < 1:
            return collections.Counter()
        out = self.upstream.run([
            "blame", "--porcelain", "-L", f"{start},{end}", revision, "--", path
        ], check=False)
        result: collections.Counter[str] = collections.Counter()
        for line in out.splitlines():
            m = re.match(rf"^({HEX40})\s", line)
            if m:
                result[m.group(1).lower()] += 1
        return result

    def extract_symbols(self, sha: str, only_paths: set[str] | None = None) -> set[str]:
        symbols: set[str] = set()
        for path, _os, _oc, _ns, _nc, added in self.parse_hunks(sha, only_paths):
            del path
            for line in added:
                for sym in FUNC_CALL_RE.findall(line):
                    if sym not in C_KEYWORDS and sym not in IGNORE_SYMBOLS:
                        symbols.add(sym)
                for sym in MACRO_RE.findall(line):
                    if sym not in IGNORE_SYMBOLS and not sym.startswith("CONFIG_"):
                        symbols.add(sym)
        return set(sorted(symbols)[: self.args.max_symbols])

    def symbol_definition_dependency(self, sha: str, symbol: str) -> str | None:
        parents = self.upstream.parents(sha)
        if len(parents) != 1:
            return None
        parent = parents[0]
        out = self.upstream.run([
            "grep", "-n", "-E", rf"\b{re.escape(symbol)}\b", parent, "--", "*.c", "*.h"
        ], check=False)
        for raw in out.splitlines()[:300]:
            m = re.match(r"^[^:]+:(.+?):(\d+):(.*)$", raw)
            if not m:
                continue
            path, line_s, text = m.groups()
            text_s = text.strip()
            definitionish = (
                re.search(rf"^#\s*define\s+{re.escape(symbol)}\b", text_s)
                or re.search(rf"\b{re.escape(symbol)}\s*\([^;]*\)\s*(?:\{{|$)", text_s)
                or re.search(rf"\b(?:enum|struct|union|typedef)\b.*\b{re.escape(symbol)}\b", text_s)
            )
            if not definitionish:
                continue
            blame = self.blame_range(parent, path, int(line_s), int(line_s))
            if blame:
                dep = blame.most_common(1)[0][0]
                if dep != sha and self.upstream.is_ancestor(dep, sha):
                    return dep
        return None

    def dependency_candidates(self, conflict: ConflictInfo) -> list[DependencyCandidate]:
        sha = conflict.sha
        only = set(conflict.files)
        scores: collections.Counter[str] = collections.Counter()
        reasons: dict[str, set[str]] = collections.defaultdict(set)
        dep_files: dict[str, set[str]] = collections.defaultdict(set)
        parents = self.upstream.parents(sha)
        if len(parents) != 1:
            return []
        parent = parents[0]

        # A Fixes: target is strong semantic context when it is not already
        # represented in the working downstream.
        for fixed in self.fixes_targets(sha):
            if self.upstream.is_ancestor(fixed, sha):
                scores[fixed] += 100
                reasons[fixed].add("Fixes-target")

        # Exact hunk preimage and nearby context provenance.  This reproduces
        # the useful part of the manual per-file history investigation without
        # assuming every commit in the file log is a prerequisite.
        for path, old_start, old_count, _new_start, _new_count, _added in self.parse_hunks(sha, only):
            if old_count:
                blame = self.blame_range(parent, path, old_start, old_start + old_count - 1)
                for dep, count in blame.items():
                    scores[dep] += 12 * count
                    reasons[dep].add(f"hunk-preimage:{path}")
                    dep_files[dep].add(path)
            lo = max(1, old_start - self.args.context_lines)
            hi = max(lo, old_start + max(old_count, 1) + self.args.context_lines)
            blame = self.blame_range(parent, path, lo, hi)
            for dep, count in blame.items():
                scores[dep] += count
                reasons[dep].add(f"nearby-context:{path}")
                dep_files[dep].add(path)

        # New API/macro uses can originate outside the subsystem entirely.
        for sym in self.extract_symbols(sha, only):
            dep = self.symbol_definition_dependency(sha, sym)
            if dep:
                scores[dep] += 25
                reasons[dep].add(f"symbol:{sym}")

        candidates: list[DependencyCandidate] = []
        for dep, score in scores.most_common():
            if dep == sha or dep in self.plan or dep in self._candidate_seen:
                continue
            if len(self.upstream.parents(dep)) != 1:
                # Never automatically cherry-pick an upstream merge commit.
                continue
            if not self.upstream.is_ancestor(dep, sha):
                continue
            work_match = self.match_working(dep)
            if work_match.present:
                continue
            current_match = self.match_current(dep)
            if current_match.present:
                self.outdated_dependencies.append((dep, current_match))
                continue
            candidates.append(DependencyCandidate(
                dep, score, sorted(reasons[dep]), sorted(dep_files[dep])
            ))
        return candidates

    def later_context(self, sha: str, files: list[str]) -> list[tuple[str, IdentityMatch, str]]:
        if not files:
            return []
        out = self.upstream.run([
            "log", "--no-merges", "--format=%H", f"{sha}..{self.target}", "--", *files
        ], check=False)
        found: list[tuple[str, IdentityMatch, str]] = []
        for later in out.splitlines()[: self.args.max_later_context]:
            m = self.match_working(later)
            if not m.present:
                m = self.match_current(later)
            if m.present:
                found.append((later, m, self.subject(later)))
        return found

    def later_merge_risks(self, sha: str, files: list[str]) -> list[str]:
        if not files:
            return []
        out = self.upstream.run([
            "log", "--merges", "--format=%H", "--ancestry-path", f"{sha}..{self.target}",
            "--", *files
        ], check=False)
        return out.splitlines()[: self.args.max_merge_risks]

    def seed_fixes_dependency(self) -> None:
        for fixed in self.fixes_targets(self.requested):
            if not self.upstream.is_ancestor(fixed, self.requested):
                continue
            if self.match_working(fixed).present:
                continue
            cm = self.match_current(fixed)
            if cm.present:
                self.outdated_dependencies.append((fixed, cm))
                continue
            self.plan.add(fixed)
            self.auto_added.add(fixed)
            self.reason_map[fixed].append(f"Fixes-target of {self.requested[:12]}")

    def discover_plan(self) -> SequenceResult:
        self.plan = {self.requested}

        requested_work = self.match_working(self.requested)
        if requested_work.present:
            self.plan.clear()
            return SequenceResult(
                True, [], requested_present=requested_work
            )

        self.seed_fixes_dependency()

        requested_current = self.match_current(self.requested)
        if requested_current.present and not requested_work.present:
            raise KBError(
                "requested commit is already present in today's CS10 reference but not in your "
                f"working tree (CS10 commit {requested_current.downstream_sha}). Sync/rebase the "
                "working tree instead of creating a duplicate backport."
            )

        print("\nPreflighting requested backport in an isolated clone...")
        for round_no in range(1, self.args.max_rounds + 1):
            result = self.simulate()
            if result.clean:
                if self.args.check_command:
                    checked = self.simulate(run_check=True)
                    if checked.clean:
                        return checked
                    # Build/test failure is not currently permission to invent a
                    # code fix.  We do a narrow symbol-recovery pass below.
                    if checked.check_output:
                        added = self.add_build_symbol_dependencies(checked.check_output)
                        if added:
                            print(
                                f"  round {round_no}: build/test exposed {added} additional "
                                "upstream symbol prerequisite(s); retrying"
                            )
                            continue
                    return checked
                return result

            assert result.conflict is not None
            self.latest_conflict = result.conflict
            c = result.conflict
            print(
                f"  round {round_no}: conflict at {c.sha[:12]} {self.subject(c.sha)}"
            )
            for path in c.files:
                print(f"      {path}")

            candidates = self.dependency_candidates(c)
            if not candidates:
                return result

            # Add one strongest candidate at a time.  This makes the next replay
            # an experiment: did this piece of upstream history actually move us
            # toward a clean cherry-pick?  A later minimization pass removes any
            # candidate that turned out not to be necessary.
            cand = candidates[0]
            self._candidate_seen.add(cand.sha)
            self.plan.add(cand.sha)
            self.auto_added.add(cand.sha)
            self.reason_map[cand.sha].extend(cand.reasons)
            print(
                f"      trying prerequisite {cand.sha[:12]} (score {cand.score}): "
                f"{self.subject(cand.sha)}"
            )

        return self.simulate()

    def add_build_symbol_dependencies(self, output: str) -> int:
        symbols: set[str] = set()
        for regex in BUILD_SYMBOL_RES:
            for m in regex.finditer(output):
                symbols.add(m.group("sym"))
        added = 0
        for sym in sorted(symbols):
            dep = self.symbol_definition_dependency(self.requested, sym)
            if not dep or dep in self.plan or self.match_working(dep).present:
                continue
            cm = self.match_current(dep)
            if cm.present:
                self.outdated_dependencies.append((dep, cm))
                continue
            self.plan.add(dep)
            self.auto_added.add(dep)
            self.reason_map[dep].append(f"build-symbol:{sym}")
            added += 1
        return added

    def minimize_plan(self) -> None:
        if not self.auto_added or self.latest_conflict is None:
            return
        print("\nChecking whether discovered prerequisites are actually necessary...")
        changed = True
        while changed:
            changed = False
            # Newest first tends to remove redundant context helpers quickly.
            for dep in reversed(self.ordered_plan(self.auto_added)):
                trial = set(self.plan)
                trial.discard(dep)
                result = self.simulate(trial)
                if result.clean:
                    print(f"  removing nonessential candidate {dep[:12]} {self.subject(dep)}")
                    self.plan.remove(dep)
                    self.auto_added.discard(dep)
                    changed = True
                    break

    def patch_series(self) -> tuple[str, list[SeriesPeer]]:
        if not self.args.series:
            return "disabled", []
        links = LINK_RE.findall(self.body(self.requested))
        msgids: list[str] = []
        for link in links:
            m = LORE_MSGID_RE.search(link)
            if m:
                msgids.append(m.group(1))
        if not msgids:
            return "not-found", []

        # Git send-email commonly produces message IDs with a stable stem and
        # a per-patch numeric suffix.  Search commit messages in the target
        # history for that stem.  This is local/inferred series detection, not a
        # claim that Git history replaces the mailing-list thread.
        m = SERIES_MSGID_RE.match(msgids[0])
        if not m:
            return "link-found-no-local-series", []
        stem = m.group("stem")
        tail = m.group("tail")
        grep = f"{stem}-"
        raw = self.upstream.run([
            "log", "--no-merges", "--format=%H", "--fixed-strings", f"--grep={grep}", self.target
        ], check=False)
        peers: list[SeriesPeer] = []
        for sha in raw.splitlines():
            body = self.body(sha)
            patch_no: int | None = None
            same = False
            for link in LINK_RE.findall(body):
                lm = LORE_MSGID_RE.search(link)
                if not lm:
                    continue
                mm = SERIES_MSGID_RE.match(lm.group(1))
                if mm and mm.group("stem") == stem and mm.group("tail") == tail:
                    same = True
                    patch_no = int(mm.group("num"))
                    break
            if not same:
                continue
            wm = self.match_working(sha)
            cm = self.match_current(sha)
            if sha == self.requested:
                status = "REQUESTED"
                chosen = wm if wm.present else cm
            elif wm.present:
                status = "PRESENT-WORKTREE"
                chosen = wm
            elif cm.present:
                status = "PRESENT-CS10-TODAY"
                chosen = cm
            else:
                status = "MISSING"
                chosen = IdentityMatch()
            peers.append(SeriesPeer(
                sha, self.subject(sha), patch_no, status,
                chosen.downstream_sha, chosen.method,
            ))
        peers.sort(key=lambda p: (p.patch_number is None, p.patch_number or 10**9, p.sha))
        return "inferred-from-lore-message-id", peers

    def print_series(self, method: str, peers: list[SeriesPeer]) -> None:
        print(f"\nPatch-series discovery: {method}")
        if not peers:
            print("  No local series peers identified.")
            return
        for peer in peers:
            num = f"{peer.patch_number:02d}" if peer.patch_number is not None else "??"
            status = f"{peer.status:20s}"
            if peer.status in ("PRESENT-WORKTREE", "PRESENT-CS10-TODAY"):
                status = color_stdout(status, ANSI_GREEN)
            print(f"  {num}  {peer.sha[:12]}  {status}  {peer.subject}")
            if peer.downstream_sha:
                print(
                    f"      downstream {peer.downstream_sha[:12]} via {peer.method}"
                )
        print("  Series peers are informational; they are never auto-backported merely because they share a series.")

    def later_fixes(self) -> list[str]:
        short = self.requested[:12]
        raw = self.upstream.run([
            "log", "--no-merges", "--format=%H%x00%B%x00", f"{self.requested}..{self.target}"
        ], check=False)
        parts = raw.split("\0")
        result: list[str] = []
        for i in range(0, len(parts) - 1, 2):
            sha = parts[i].strip()
            body = parts[i + 1]
            for fx in FIXES_RE.findall(body):
                if self.requested.startswith(fx) or fx.startswith(short):
                    result.append(sha)
                    break
        return result

    def save_upstream_diff(self, sha: str) -> Path:
        self.diff_dir.mkdir(parents=True, exist_ok=True)
        path = self.diff_dir / f"{sha}.diff"
        path.write_text(self.upstream.run(["show", sha]))
        return path

    def commit_message(self, sha: str) -> str:
        subject = self.subject(sha)
        header = self.upstream.medium_header(sha)
        name = self.args.signoff_name or self.work_git.run(["config", "user.name"], check=False).strip()
        email = self.args.signoff_email or self.work_git.run(["config", "user.email"], check=False).strip()
        if not name or not email:
            raise KBError(
                "git user.name/user.email are required for Signed-off-by; set them or use "
                "--signoff-name/--signoff-email"
            )
        return (
            f"{subject}\n\n"
            f"JIRA: {self.args.jira_url.rstrip('/')}/{self.args.jira}\n\n"
            f"{header}\n\n"
            f"(cherry picked from commit {sha})\n"
            f"Signed-off-by: {name} <{email}>\n"
        )

    def apply_real(self) -> list[str]:
        if self.args.dry_run:
            return []
        if self.work_git.rev_parse("HEAD") != self.start_head:
            raise KBError("working HEAD changed during analysis; refusing to apply the preflighted plan")
        if not self.work_git.status_clean():
            raise KBError("working tree changed during analysis; refusing to apply")

        commits: list[str] = []
        print("\nApplying preflighted sequence to the real working tree...")
        for sha in self.ordered_plan():
            self.save_upstream_diff(sha)
            self.work_git.run(["fetch", "--no-tags", str(self.refs.upstream_path), sha])
            cp = self.work_git._run_cp(["cherry-pick", "--no-commit", sha], check=False)
            if cp.returncode:
                raise KBError(
                    f"unexpected real-tree cherry-pick failure at {sha}; the preflight succeeded. "
                    "The conflict has been left in the working tree for inspection."
                )
            msg = self.commit_message(sha)
            with tempfile.NamedTemporaryFile("w", delete=False, prefix="kernel-backporter-msg-") as tf:
                tf.write(msg)
                msg_path = tf.name
            try:
                self.work_git.run(["commit", "-F", msg_path])
            finally:
                Path(msg_path).unlink(missing_ok=True)
            new_sha = self.work_git.rev_parse("HEAD")
            commits.append(new_sha)
            self.patch_dir.mkdir(parents=True, exist_ok=True)
            self.work_git.run(["format-patch", "-1", "HEAD", "-o", str(self.patch_dir)])
            print(f"  {sha[:12]} -> {new_sha[:12]}  {self.subject(sha)}")
        if commits:
            print()
            print(color_stdout("Backport result: COMMITTED", ANSI_BOLD, ANSI_GREEN))
        return commits

    def write_dossier(self, result: SequenceResult) -> Path | None:
        conflict = result.conflict
        if conflict is None:
            return None
        root = self.report_root / self.requested
        root.mkdir(parents=True, exist_ok=True)
        (root / "requested.diff").write_text(self.upstream.run(["show", self.requested]))
        (root / "conflict-summary.txt").write_text(
            f"requested: {self.requested} {self.subject(self.requested)}\n"
            f"failed-at: {conflict.sha} {self.subject(conflict.sha)}\n"
            f"files:\n" + "".join(f"  {x}\n" for x in conflict.files)
        )

        parents = self.upstream.parents(conflict.sha)
        parent = parents[0] if len(parents) == 1 else None
        for path in conflict.files:
            safe = path.replace("/", "__")
            d = root / safe
            d.mkdir(parents=True, exist_ok=True)
            if parent:
                text = self.upstream.run(["show", f"{parent}:{path}"], check=False)
                (d / "upstream-parent.c").write_text(text)
            (d / "upstream-after.c").write_text(
                self.upstream.run(["show", f"{conflict.sha}:{path}"], check=False)
            )
            (d / "upstream-target.c").write_text(
                self.upstream.run(["show", f"{self.target}:{path}"], check=False)
            )
            (d / "downstream-working.c").write_text(
                self.work_git.run(["show", f"HEAD:{path}"], check=False)
            )
            (d / "downstream-current.c").write_text(
                self.current_ds.run(["show", f"{self.current_ds_head}:{path}"], check=False)
            )
            history = self.upstream.run([
                "log", "--oneline", "--decorate=no", self.target, "--", path
            ], check=False)
            (d / "upstream-history.txt").write_text(history)

        candidates = self.dependency_candidates(conflict)
        lines = []
        for c in candidates:
            lines.append(
                f"{c.sha} score={c.score} {self.subject(c.sha)}\n"
                f"    reasons: {', '.join(c.reasons)}\n"
            )
        (root / "candidate-dependencies.txt").write_text("".join(lines))
        later = self.later_context(conflict.sha, conflict.files)
        with (root / "later-downstream-context.txt").open("w") as f:
            for sha, match, subject in later:
                f.write(
                    f"{sha} {subject}\n"
                    f"    downstream={match.downstream_sha} via={match.method} source={match.source}\n"
                )
        merges = self.later_merge_risks(conflict.sha, conflict.files)
        (root / "later-merge-risks.txt").write_text("\n".join(merges) + ("\n" if merges else ""))
        return root

    def write_report(
        self,
        result: SequenceResult,
        series_method: str,
        peers: list[SeriesPeer],
        real_commits: list[str],
        dossier: Path | None,
    ) -> Path:
        root = self.report_root / self.requested
        root.mkdir(parents=True, exist_ok=True)
        report = root / "report.txt"
        lines: list[str] = []
        lines.append(f"requested:   {self.requested}  {self.subject(self.requested)}")
        lines.append(f"target:      {self.args.target} -> {self.target}")
        lines.append(f"work-head:   {self.start_head}")
        lines.append(f"cs10-today:  {self.current_ds_head}")
        lines.append(f"upstream:    {self.refs.upstream_path}")
        lines.append(f"downstream:  {self.refs.downstream_path}")
        lines.append("")
        lines.append("PROPOSED / APPLIED SEQUENCE")
        lines.append("=" * 80)
        for i, sha in enumerate(self.ordered_plan(), 1):
            kind = "REQUESTED" if sha == self.requested else "PREREQUISITE"
            lines.append(f"{i:3d}. {sha} [{kind}] {self.subject(sha)}")
            if sha in self.reason_map:
                lines.append("     reasons: " + ", ".join(sorted(set(self.reason_map[sha]))))
        lines.append("")
        lines.append(f"preflight: {'CLEAN' if result.clean else 'STOPPED'}")
        if result.check_rc is not None:
            lines.append(f"check-command rc: {result.check_rc}")
        if result.conflict:
            lines.append(
                f"conflict: {result.conflict.sha} {self.subject(result.conflict.sha)}"
            )
            lines.extend(f"    {x}" for x in result.conflict.files)
        if self.outdated_dependencies:
            lines.append("")
            lines.append("DEPENDENCIES PRESENT IN TODAY'S CS10 BUT NOT WORKING TREE")
            lines.append("=" * 80)
            for sha, match in self.outdated_dependencies:
                lines.append(
                    f"{sha} {self.subject(sha)}\n"
                    f"    CS10={match.downstream_sha} via={match.method}"
                )
        lines.append("")
        lines.append(f"PATCH SERIES: {series_method}")
        lines.append("=" * 80)
        if peers:
            for p in peers:
                num = f"{p.patch_number:02d}" if p.patch_number is not None else "??"
                lines.append(f"{num}  {p.sha}  {p.status:20s}  {p.subject}")
                if p.downstream_sha:
                    lines.append(f"    downstream={p.downstream_sha} via={p.method}")
        else:
            lines.append("No local series peers identified.")

        fixes = self.later_fixes()
        lines.append("")
        lines.append("LATER FIXES OF REQUESTED COMMIT")
        lines.append("=" * 80)
        if fixes:
            for sha in fixes:
                lines.append(f"{sha} {self.subject(sha)}")
        else:
            lines.append("None identified through Fixes: tags before target.")

        if real_commits:
            lines.append("")
            lines.append("DOWNSTREAM COMMITS CREATED")
            lines.append("=" * 80)
            lines.extend(real_commits)
        if dossier:
            lines.append("")
            lines.append(f"conflict dossier: {dossier}")
        report.write_text("\n".join(lines) + "\n")

        payload = {
            "requested": self.requested,
            "requested_subject": self.subject(self.requested),
            "target": self.target,
            "target_name": self.args.target,
            "work_head": self.start_head,
            "current_downstream": self.current_ds_head,
            "sequence": self.ordered_plan(),
            "reasons": {k: sorted(set(v)) for k, v in self.reason_map.items()},
            "preflight_clean": result.clean,
            "conflict": None if not result.conflict else dataclasses.asdict(result.conflict),
            "check_rc": result.check_rc,
            "check_output": result.check_output,
            "series_method": series_method,
            "series": [dataclasses.asdict(p) for p in peers],
            "later_fixes": fixes,
            "real_commits": real_commits,
            "dossier": None if dossier is None else str(dossier),
            "references": {
                "upstream": str(self.refs.upstream_path),
                "downstream": str(self.refs.downstream_path),
            },
            "timestamp": dt.datetime.now(dt.timezone.utc).isoformat(),
        }
        (root / "report.json").write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
        return report

    def run(self) -> int:
        self.prepare()
        self.save_upstream_diff(self.requested)
        series_method, peers = self.patch_series()
        self.print_series(series_method, peers)

        result = self.discover_plan()
        if result.requested_present is not None:
            match = result.requested_present
            print()
            print(color_stdout(
                "Requested commit is already represented in the working tree via "
                f"{match.method}: {match.downstream_sha}",
                ANSI_BOLD, ANSI_YELLOW,
            ))
            return 0

        if result.clean and self.auto_added:
            self.minimize_plan()
            # Re-run after minimization, including the optional check command.
            result = self.simulate(run_check=bool(self.args.check_command))

        dossier = None
        real_commits: list[str] = []
        if result.clean:
            print("\n" + color_stdout("Preflight result: SUCCESS", ANSI_BOLD, ANSI_YELLOW))
            print("Sequence:")
            for i, sha in enumerate(self.ordered_plan(), 1):
                label = "requested" if sha == self.requested else "prerequisite"
                print(f"  {i}. {sha} [{label}] {self.subject(sha)}")
            if self.args.dry_run:
                print("\n--dry-run specified; real working tree was not modified.")
            else:
                real_commits = self.apply_real()
        else:
            print("\n" + color_stdout("Preflight result: STOPPED", ANSI_BOLD, ANSI_RED))
            if result.conflict:
                later = self.later_context(result.conflict.sha, result.conflict.files)
                if later:
                    print("Later upstream context already represented downstream:")
                    for sha, match, subject in later:
                        print(
                            f"  {sha[:12]} -> {match.downstream_sha[:12] if match.downstream_sha else '?'} "
                            f"{subject}"
                        )
                print("No clean upstream prerequisite sequence was proven. Manual resolution required.")
                dossier = self.write_dossier(result)
                print(f"Conflict dossier: {dossier}")
            elif result.check_rc is not None:
                print(f"Build/test command failed with rc={result.check_rc}; no source edit was attempted.")

        report = self.write_report(result, series_method, peers, real_commits, dossier)
        print(f"Report: {report}")
        if result.clean:
            return 0
        return 2 if result.conflict else 3


SHA40_RE = re.compile(r"^[0-9a-f]{40}$")


@dataclasses.dataclass
class BackportPlan:
    """Validated, immutable input from kernel-backport-planner."""

    path: Path
    digest: str
    baseline: str
    target: str
    order: list[str]
    commits: dict[str, dict]

    @classmethod
    def load(cls, filename: str) -> "BackportPlan":
        import hashlib

        path = Path(filename).expanduser().resolve()
        try:
            raw = path.read_bytes()
            payload = json.loads(raw)
        except (OSError, ValueError) as exc:
            raise KBError(f"cannot load plan {path}: {exc}") from exc
        if not isinstance(payload, dict):
            raise KBError("plan JSON must be an object")
        for field in ("downstream", "target", "replay_start"):
            if not isinstance(payload.get(field), str) or not SHA40_RE.fullmatch(payload[field]):
                raise KBError(f"invalid/missing plan {field} (expected full 40-character SHA)")
        if payload["downstream"] != payload["replay_start"]:
            raise KBError("plan downstream and replay_start differ; cannot establish execution baseline")
        order = payload.get("order")
        commits = payload.get("commits")
        if not isinstance(order, list) or not isinstance(commits, dict) or not order:
            raise KBError("plan must provide nonempty order and commits collections")
        for sha in order:
            if not isinstance(sha, str) or not SHA40_RE.fullmatch(sha):
                raise KBError(f"invalid ordered SHA: {sha!r}")
        if len(set(order)) != len(order):
            raise KBError("plan order contains duplicate SHAs")
        for sha in order:
            record = commits.get(sha)
            if not isinstance(record, dict):
                raise KBError(f"ordered commit missing from commits mapping: {sha}")
            if record.get("selected") is not True or not isinstance(record.get("match"), dict) or record["match"].get("status") != "missing":
                raise KBError(f"ordered commit is not selected/missing in plan: {sha}")
            if record.get("advisor_decision") not in ("TAKE", "SKIP", "REVIEW"):
                raise KBError(f"invalid advisor decision for {sha}: {record.get('advisor_decision')!r}")
            prereqs = record.get("advisor_prerequisites", [])
            if not isinstance(prereqs, list):
                raise KBError(f"invalid advisor prerequisites on {sha}")
            for item in prereqs:
                if not isinstance(item, dict) or not isinstance(item.get("sha"), str) or not SHA40_RE.fullmatch(item["sha"]):
                    raise KBError(f"invalid advisor prerequisite for {sha}: {item!r}")
        return cls(path, hashlib.sha256(raw).hexdigest(), payload["downstream"],
                   payload["target"], list(order), commits)


class PlanTextProgress:
    """Render a user-named progress copy of the original planner text report.

    The JSON controls plan order and policy, while the execution journal controls
    completion status. The original human-readable text is never modified.
    """

    HEADER_RE = re.compile(
        r'^(?P<sha>[0-9a-f]{12}) (?:\[[^\]\n]+\] )?\(.*?\) '
        r'(?P<comment>// (?P<decision>Take|Skip|Review))$', re.MULTILINE
    )

    def __init__(self, source: Path, plan: BackportPlan):
        self.source = source
        try:
            self.original = source.read_text()
        except OSError as exc:
            raise KBError(f"cannot read planner text report {source}: {exc}") from exc
        self.matches = list(self.HEADER_RE.finditer(self.original))
        actual = [m.group("sha") for m in self.matches]
        expected = [sha[:12] for sha in plan.order]
        if actual != expected:
            raise KBError(
                f"planner text report {source} does not match JSON order "
                f"({len(actual)} text entries versus {len(expected)} JSON entries)"
            )
        for match, sha in zip(self.matches, plan.order):
            decision = plan.commits[sha]["advisor_decision"].capitalize()
            if match.group("decision") != decision:
                raise KBError(
                    f"planner text report decision for {sha[:12]} differs "
                    "from JSON; refusing to annotate mismatched plans"
                )

    @staticmethod
    def _review_reason(reason: str) -> str:
        if reason.startswith(("preflight failed:",
                              "unexpected real-tree cherry-pick failure:")):
            return "Review (conflict)"
        if reason.startswith("unresolved advisor prerequisite(s):"):
            return "Review (prerequisite)"
        return "Review (manual)"

    def render(self, plan: BackportPlan, journal: dict) -> str:
        entries = {entry["sha"]: entry for entry in journal["entries"]}
        blocked = journal.get("blocked")
        chunks = []
        prev = 0
        for sha, match in zip(plan.order, self.matches):
            chunks.append(self.original[prev:match.start("comment")])
            status = match.group("comment")
            entry = entries.get(sha)
            if entry and entry["status"] in ("APPLIED", "APPLIED_MANUALLY"):
                downstream = entry.get("downstream_sha")
                if not isinstance(downstream, str) or not SHA40_RE.fullmatch(downstream):
                    raise KBError(f"journal is missing downstream SHA for {sha}")
                status = "// Done " + downstream[:12]
            elif entry and entry["status"] == "ALREADY_PRESENT":
                status = "// Done (already present)"
            elif blocked and blocked.get("sha") == sha:
                status = "// " + self._review_reason(blocked.get("reason", ""))
            chunks.append(status)
            prev = match.end("comment")
        chunks.append(self.original[prev:])
        return "".join(chunks)

    def write_to(self, destination: Path, plan: BackportPlan, journal: dict) -> Path:
        """Publish the user-named report atomically, without replacing files."""
        rendered = self.render(plan, journal)
        fd, temporary = tempfile.mkstemp(prefix=".backport-progress-",
                                          dir=destination.parent)
        try:
            with os.fdopen(fd, "w") as output:
                output.write(rendered)
                output.flush()
                os.fsync(output.fileno())
            try:
                os.link(temporary, destination)
            except FileExistsError as exc:
                raise KBError(f"progress output already exists: {destination}") from exc
            except OSError as exc:
                raise KBError(f"cannot create progress output {destination}: {exc}") from exc
            return destination
        finally:
            Path(temporary).unlink(missing_ok=True)


class BackportWorksheet:
    """Maintain a live engineer-editable worksheet from journal state.

    The JSON plan, not worksheet annotations, controls the execution order.
    Only the status field of a recognized commit header and the immediately
    adjacent machine-owned blocker line may be changed. All other text is
    preserved, including annotations inserted by the engineer.
    """

    HEADER_RE = re.compile(
        r'^(?P<prefix>[0-9a-f]{12} (?:\[[^\]\n]+\] )?\(.*?\) )'
        r'// (?P<status>Take|Skip|Review(?: \([^\n)]*\))?|'
        r'Done(?: [0-9a-f]{12,40}| \(already present\)))$'
    )
    MANAGED_RE = re.compile(r"^      backporter: BLOCKED (.*)$")

    def __init__(self, filename: str, plan: BackportPlan):
        # Refuse symlinks rather than following them into an unrelated file.
        path = Path(os.path.abspath(Path(filename).expanduser()))
        if path.is_symlink() or not path.is_file():
            raise KBError(f"worksheet must be an existing regular file: {path}")
        if path.resolve() == plan.path or not path.parent.is_dir():
            raise KBError("worksheet must be separate from the immutable JSON plan")
        self.path = path
        self.plan = plan
        self._read_validated()

    def _read_validated(self) -> tuple[bytes, list[str]]:
        if self.path.is_symlink() or not self.path.is_file():
            raise KBError(f"worksheet is missing or a symlink: {self.path}")
        try:
            raw = self.path.read_bytes()
            text = raw.decode("utf-8")
        except (OSError, UnicodeError) as exc:
            raise KBError(f"cannot read worksheet {self.path}: {exc}") from exc
        lines = text.splitlines(keepends=True)
        matches = [self.HEADER_RE.fullmatch(line.rstrip("\r\n"))
                   for line in lines]
        found = [match for match in matches if match]
        actual = [match.group("prefix")[:12] for match in found]
        expected = [sha[:12] for sha in self.plan.order]
        if actual != expected:
            raise KBError(
                f"worksheet entries do not match plan JSON order "
                f"({len(actual)} worksheet entries versus "
                f"{len(expected)} ordered commits): {self.path}"
            )
        for match, sha in zip(found, self.plan.order):
            original = self.plan.commits[sha]["advisor_decision"].capitalize()
            # A live worksheet can already have machine-generated status.
            status = match.group("status")
            if status in ("Take", "Skip", "Review") and status != original:
                raise KBError(f"worksheet decision for {sha[:12]} contradicts "
                              "the immutable plan JSON")
        return raw, lines

    @staticmethod
    def _blocked_line(blocked: dict | None, sha: str) -> str | None:
        if not blocked or blocked.get("sha") != sha:
            return None
        reason = " ".join(str(blocked.get("reason", "unknown")).split())
        reason = reason[:500]
        files = blocked.get("files") or []
        details = f"; files={','.join(str(x) for x in files[:12])}" if files else ""
        dossier = blocked.get("dossier")
        if dossier:
            details += f"; dossier={dossier}"
        return f"      backporter: BLOCKED {reason}{details}"

    def render(self, journal: dict, lines: list[str]) -> str:
        entries = {entry["sha"]: entry for entry in journal["entries"]}
        blocked = journal.get("blocked")
        out = []
        cursor = 0
        i = 0
        while i < len(lines):
            line = lines[i]
            match = self.HEADER_RE.fullmatch(line.rstrip("\r\n"))
            if not match:
                out.append(line)
                i += 1
                continue
            sha = self.plan.order[cursor]
            cursor += 1
            entry = entries.get(sha)
            status = self.plan.commits[sha]["advisor_decision"].capitalize()
            if entry and entry["status"] in ("APPLIED", "APPLIED_MANUALLY"):
                downstream = entry.get("downstream_sha")
                if not isinstance(downstream, str) or not SHA40_RE.fullmatch(downstream):
                    raise KBError(f"journal missing downstream SHA for {sha}")
                status = "Done " + downstream[:12]
            elif entry and entry["status"] == "ALREADY_PRESENT":
                status = "Done (already present)"
            elif blocked and blocked.get("sha") == sha:
                reason = str(blocked.get("reason", ""))
                status = PlanTextProgress._review_reason(reason)
            # Preserve existing newline style and all unrelated text.
            newline = "\r\n" if line.endswith("\r\n") else (
                "\n" if line.endswith("\n") else "")
            out.append(match.group("prefix") + "// " + status + newline)
            i += 1
            # This one line is machine-owned; all other annotations are opaque.
            if i < len(lines) and self.MANAGED_RE.fullmatch(lines[i].rstrip("\r\n")):
                i += 1
            note = self._blocked_line(blocked, sha)
            if note:
                out.append(note + (newline or "\n"))
        return "".join(out)

    def synchronize(self, journal: dict) -> bool:
        """Atomically publish validated status changes; preserve manual edits.

        If the engineer changes the worksheet during preparation, refuse to
        overwrite the concurrent edit. The next invocation will resync.
        """
        import hashlib
        import stat

        raw, lines = self._read_validated()
        updated = self.render(journal, lines).encode("utf-8")
        if updated == raw:
            return False
        original_hash = hashlib.sha256(raw).digest()
        mode = stat.S_IMODE(self.path.stat().st_mode)
        fd, temporary = tempfile.mkstemp(prefix=".backport-worksheet-",
                                          dir=self.path.parent)
        try:
            with os.fdopen(fd, "wb") as output:
                os.fchmod(output.fileno(), mode)
                output.write(updated)
                output.flush()
                os.fsync(output.fileno())
            if (self.path.is_symlink() or not self.path.is_file()
                    or hashlib.sha256(self.path.read_bytes()).digest() != original_hash):
                raise KBError("worksheet changed during update; refusing to "
                              f"overwrite engineer edits: {self.path}")
            os.replace(temporary, self.path)
        finally:
            Path(temporary).unlink(missing_ok=True)
        return True


class PlannedBackporter(KernelBackporter):
    """Conservative bounded execution of an explicit planner TAKE sequence.

    This mode never runs independent prerequisite discovery. A conflict is a
    stop condition; it is not permission to import other upstream commits.
    """

    def __init__(self, args: argparse.Namespace):
        super().__init__(args)
        self.batch_plan = BackportPlan.load(args.plan)
        # Keep journals separate across plan versions AND across different trees.
        # The journal itself checks canonical repository identity.
        # Generic plan filenames are reused in every planning cycle. Use
        # the numbered parent directory to keep journals distinct even when
        # two planning runs produce byte-identical JSON plans.
        plan_name = self.batch_plan.path.stem
        if (plan_name == "backport_plan"
                and re.fullmatch(r"backport_plan_\d+",
                                 self.batch_plan.path.parent.name)):
            # Keep same-numbered/digested cycles in separate workspaces
            # independent, even when they share a downstream repository.
            identity = str(self.batch_plan.path.parent) + "\n" + str(self.repo)
            cycle_key = hashlib.sha256(identity.encode()).hexdigest()[:8]
            plan_name = self.batch_plan.path.parent.name + "-" + cycle_key
        self.state_dir = self.report_root / "plans" / (
            plan_name + "-" + self.batch_plan.digest[:12]
        )
        self.journal_path = (Path(args.journal).expanduser().resolve()
                             if args.journal else self.state_dir / "journal.json")
        # 0.2.5 keyed generic filenames only by their JSON digest. Reuse an
        # existing older journal ONLY when it explicitly names this same plan
        # path. Do not accidentally borrow another cycle's identical plan.
        if not args.journal and plan_name != self.batch_plan.path.stem:
            legacy = (self.report_root / "plans" /
                      ("backport_plan-" + self.batch_plan.digest[:12]) /
                      "journal.json")
            if not self.journal_path.exists() and legacy.is_file():
                try:
                    previous = json.loads(legacy.read_text())
                except (OSError, ValueError):
                    previous = None
                if (isinstance(previous, dict)
                        and previous.get("plan_path") == str(self.batch_plan.path)
                        and previous.get("repo") == str(self.repo)):
                    self.journal_path = legacy
        self.journal: dict = {}
        self.text_progress: PlanTextProgress | None = None
        self.progress_output: Path | None = None
        self.worksheet: BackportWorksheet | None = None
        self.work_index: ProvenanceIndex

    def _new_journal(self) -> dict:
        return {
            "schema_version": 1,
            "plan_sha256": self.batch_plan.digest,
            "plan_path": str(self.batch_plan.path),
            "repo": str(self.repo),
            "branch": self.work_git.run(["symbolic-ref", "--short", "HEAD"], check=False).strip() or "DETACHED",
            "baseline": self.batch_plan.baseline,
            "target": self.batch_plan.target,
            "cursor": 0,
            "last_head": self.batch_plan.baseline,
            "entries": [],
            "blocked": None,
        }

    def _write_journal(self) -> None:
        self.journal_path.parent.mkdir(parents=True, exist_ok=True)
        fd, tmp = tempfile.mkstemp(prefix=".plan-journal-", dir=self.journal_path.parent)
        try:
            with os.fdopen(fd, "w") as output:
                json.dump(self.journal, output, indent=2, sort_keys=True)
                output.write("\n")
                output.flush()
                os.fsync(output.fileno())
            os.replace(tmp, self.journal_path)
        finally:
            Path(tmp).unlink(missing_ok=True)
        # The journal is committed before the worksheet. If the latter cannot
        # be written, the next invocation can recover the live worksheet.
        if self.worksheet is not None:
            self.worksheet.synchronize(self.journal)

    def _validate_journal(self, journal: dict) -> None:
        """Reject corrupt or mismatched progress before skipping plan entries.

        The worksheet is never trusted for execution state. Validate every
        journal entry, not just its cursor, before automatically continuing.
        """
        if not isinstance(journal, dict):
            raise KBError("execution journal is not a JSON object")
        expected = self._new_journal()
        for field in ("schema_version", "plan_sha256", "plan_path", "repo",
                      "branch", "baseline", "target"):
            if journal.get(field) != expected[field]:
                raise KBError(
                    f"journal {field} differs from this plan/repository")
        entries = journal.get("entries")
        cursor = journal.get("cursor")
        if (not isinstance(cursor, int) or isinstance(cursor, bool)
                or not 0 <= cursor <= len(self.batch_plan.order)
                or not isinstance(entries, list) or len(entries) != cursor):
            raise KBError("journal entries/cursor are inconsistent")
        valid = {"APPLIED", "APPLIED_MANUALLY", "ALREADY_PRESENT",
                 "SKIPPED_POLICY"}
        for position, entry in enumerate(entries):
            if (not isinstance(entry, dict)
                    or entry.get("sha") != self.batch_plan.order[position]
                    or entry.get("status") not in valid):
                raise KBError("journal entry order/status is invalid at "
                              f"position {position + 1}")
            if entry["status"] in ("APPLIED", "APPLIED_MANUALLY"):
                sha = entry.get("downstream_sha")
                if not isinstance(sha, str) or not SHA40_RE.fullmatch(sha):
                    raise KBError("journal APPLIED entry lacks downstream SHA")
        blocked = journal.get("blocked")
        if blocked is not None:
            if (not isinstance(blocked, dict) or cursor >= len(self.batch_plan.order)
                    or blocked.get("sha") != self.batch_plan.order[cursor]):
                raise KBError("journal blocked entry does not match cursor")
        recorded = journal.get("last_head")
        if not isinstance(recorded, str) or not SHA40_RE.fullmatch(recorded):
            raise KBError("journal last_head is invalid")
        last_applied = next(
            (entry["downstream_sha"] for entry in reversed(entries)
             if entry["status"] in ("APPLIED", "APPLIED_MANUALLY")),
            self.batch_plan.baseline,
        )
        if recorded != last_applied:
            raise KBError("journal last_head differs from recorded applied "
                          "commit")

    def _load_journal(self) -> bool:
        """Load valid progress if present, or prepare a fresh session.

        Returns True for an existing journal. Never reset or overwrite a
        journal simply because a command is repeated.
        """
        if not self.journal_path.exists():
            self.journal = self._new_journal()
            return False
        try:
            self.journal = json.loads(self.journal_path.read_text())
        except (OSError, ValueError) as exc:
            raise KBError(f"cannot read existing journal: {exc}") from exc
        self._validate_journal(self.journal)
        return True

    def _guard_unfinished_prior_cycles(self) -> None:
        """Do not auto-select a new cycle while another is still unfinished.

        Only journals for an earlier cycle in the same workspace, repository,
        and checked-out branch are relevant. Explicit --results-dir/--plan is
        the deliberate override, e.g. after establishing a new MR baseline.
        """
        if not getattr(self.args, "auto_selected", False):
            return
        # A journal for the newest cycle means it was already chosen, perhaps
        # explicitly with --results-dir after an MR changed the baseline.
        # The loader still validates that journal before continuing.
        if self.journal_path.is_file():
            return
        selected = self.batch_plan.path.parent
        if not re.fullmatch(r"backport_plan_\d+", selected.name):
            return
        root = selected.parent
        if root.name != "backport-plans":
            return
        current_number = int(selected.name.rsplit("_", 1)[1])
        branch = self.work_git.run(
            ["symbolic-ref", "--short", "HEAD"], check=False).strip() or "DETACHED"
        journal_root = self.report_root / "plans"
        if not journal_root.is_dir():
            return
        unfinished = set()
        for journal_path in journal_root.glob("*/journal.json"):
            if journal_path.is_symlink() or not journal_path.is_file():
                continue
            try:
                data = json.loads(journal_path.read_text())
                if not isinstance(data, dict):
                    continue
                if (data.get("repo") != str(self.repo)
                        or data.get("branch") != branch):
                    continue
                old_path = Path(data.get("plan_path", ""))
                old_dir = old_path.parent
                match = re.fullmatch(r"backport_plan_(\d+)", old_dir.name)
                if (not match or int(match.group(1)) >= current_number
                        or old_path.name != "backport_plan.json"
                        or old_dir.parent != root):
                    continue
                plan = BackportPlan.load(str(old_path))
                if data.get("plan_sha256") != plan.digest:
                    # A mismatched old plan cannot be safely classified.
                    raise KBError(f"prior journal does not match its plan: "
                                  f"{journal_path}")
                cursor = data.get("cursor")
                if (not isinstance(cursor, int) or isinstance(cursor, bool)
                        or cursor < 0 or cursor > len(plan.order)):
                    raise KBError(f"prior journal has invalid cursor: "
                                  f"{journal_path}")
                if cursor < len(plan.order) or data.get("blocked"):
                    unfinished.add(str(old_dir))
            except (OSError, ValueError, TypeError) as exc:
                raise KBError(f"cannot inspect prior journal "
                              f"{journal_path}: {exc}") from exc
        if unfinished:
            names = ", ".join(sorted(unfinished))
            raise KBError(
                f"newest plan is {selected}, but an older planning cycle "
                f"has unfinished execution: {names}. Select the intended "
                "cycle explicitly with --results-dir DIR; automatic "
                "selection will not abandon an unfinished session."
            )

    def _append(self, sha: str, status: str, **other) -> None:
        self.journal["entries"].append({"sha": sha, "status": status, **other})
        self.journal["cursor"] += 1

    def _reconcile_head(self) -> None:
        """Allow exactly one manually completed pending commit, with provenance."""
        recorded = self.journal["last_head"]
        actual = self.work_git.rev_parse("HEAD")
        if actual == recorded:
            return
        blocked = self.journal.get("blocked")
        if not blocked or self.batch_plan.order[self.journal["cursor"]] != blocked["sha"]:
            raise KBError("working HEAD differs from journal; refusing unrelated/unrecorded commits")
        if not self.work_git.is_ancestor(recorded, actual):
            raise KBError("working HEAD has diverged from journal; cannot continue")
        new = self.work_git.run(["rev-list", "--reverse", f"{recorded}..{actual}"]).splitlines()
        if len(new) != 1:
            raise KBError("expected exactly one manually resolved commit since blocked HEAD")
        body = self.work_git.body(new[0])
        upstream = blocked["sha"]
        markers = set(m.lower() for m in CHERRY_PICK_RE.findall(body))
        markers.update(m.lower() for m in UPSTREAM_COMMIT_RE.findall(body))
        if upstream not in markers:
            raise KBError(
                "manual commit lacks exact upstream cherry-pick provenance; "
                "include '(cherry picked from commit <full SHA>)'"
            )
        self._append(upstream, "APPLIED_MANUALLY", downstream_sha=new[0])
        self.journal["last_head"] = actual
        self.journal["blocked"] = None
        self._write_journal()
        print(f"Reconciled manual backport {upstream[:12]} -> {actual[:12]}")

    def prepare_plan(self) -> None:
        if self.args.worksheet:
            self.worksheet = BackportWorksheet(self.args.worksheet, self.batch_plan)
        # Legacy progress snapshots remain opt-in for explicit --plan users.
        # The new worksheet mode updates one live document in place.
        if self.worksheet is not None and self.args.progress_output:
            raise KBError("--worksheet and --progress-output are mutually exclusive")
        if self.args.progress_output:
            # Avoid resolving the final path component so dangling symlinks
            # cannot bypass the existence check and redirect the output.
            destination = Path(os.path.abspath(
                Path(self.args.progress_output).expanduser()))
            candidate = (Path(self.args.text_plan).expanduser().resolve()
                         if self.args.text_plan
                         else self.batch_plan.path.with_suffix(".c"))
            if not candidate.is_file():
                raise KBError(f"planner text report not found: {candidate}")
            if (os.path.lexists(destination) or
                    destination in (candidate, self.batch_plan.path,
                                    self.journal_path)):
                raise KBError(f"progress output already exists or names an input: {destination}")
            if not destination.parent.is_dir():
                raise KBError(f"progress output directory does not exist: {destination.parent}")
            self.text_progress = PlanTextProgress(candidate, self.batch_plan)
            self.progress_output = destination
        elif self.args.text_plan:
            raise KBError("--text-plan requires --progress-output")
        if not self.work_git.status_clean():
            raise KBError("working tree/index is not clean; resolve or commit changes first")
        if self.args.check_command:
            raise KBError("--check-command is not supported in plan mode; run kernel-builder separately")
        self._guard_unfinished_prior_cycles()
        continuing = self._load_journal()
        if continuing:
            if self.args.dry_run:
                if self.work_git.rev_parse("HEAD") != self.journal["last_head"]:
                    raise KBError(
                        "dry-run cannot reconcile changed HEAD; run without "
                        "--dry-run to reconcile a manual commit first")
            else:
                self._reconcile_head()
        # Reject stale Git state on every invocation, even if the worksheet
        # says Done. A journal is the authority for a continuing session.
        current = self.work_git.rev_parse("HEAD")
        if continuing:
            if current != self.journal["last_head"]:
                raise KBError("working HEAD does not match recorded execution state")
        elif current != self.batch_plan.baseline:
            raise KBError(f"working HEAD {current} does not match plan baseline {self.batch_plan.baseline}")
        if self.worksheet is not None and not self.args.dry_run:
            self.worksheet.synchronize(self.journal)
        self.upstream, self.current_ds, self.target, self.current_ds_head = self.refs.prepare()
        if self.target != self.batch_plan.target:
            raise KBError(f"upstream target differs from plan: {self.target} != {self.batch_plan.target}")
        if not self.work_git.ok(["cat-file", "-e", f"{self.batch_plan.baseline}^{{commit}}"]):
            raise KBError("plan baseline not found in working Git history")
        if not self.work_git.is_ancestor(self.batch_plan.baseline, current):
            raise KBError("plan baseline is not an ancestor of working HEAD")
        self.work_index = ProvenanceIndex(self.work_git, "HEAD", "working-tree", self.args.debug)
        if not self.args.dry_run and not continuing:
            self._write_journal()
        print(f"Session: {'CONTINUING' if continuing else 'STARTING'} "
              f"(cursor {self.journal['cursor']}/{len(self.batch_plan.order)})")
        print(f"Plan: {self.batch_plan.path}")
        print(f"Plan SHA256: {self.batch_plan.digest}")
        print(f"Baseline: {self.batch_plan.baseline}")
        print(f"Working HEAD: {current}")
        print(f"Selected missing commits: {len(self.batch_plan.order)}")
        print(f"Journal: {self.journal_path}")
        if self.worksheet is not None:
            print(f"Worksheet: {self.worksheet.path}")
        if self.current_ds_head != self.batch_plan.baseline:
            print("NOTE: official CS10 has advanced since the plan; the working baseline is unchanged")

    def status(self) -> int:
        """Report recorded progress against live Git without changing state.

        Do not refresh reference repositories, index millions of commits, or
        reconcile the journal here. A Git reset is not a journal reset.
        """
        self._guard_unfinished_prior_cycles()
        plan = self.batch_plan
        actual = self.work_git.rev_parse("HEAD")
        expected = self._new_journal()
        take = sum(plan.commits[sha]["advisor_decision"] == "TAKE"
                   for sha in plan.order)
        skipped = len(plan.order) - take
        print(f"Plan: {plan.path}")
        print(f"Plan SHA256: {plan.digest}")
        print(f"Baseline: {plan.baseline}")
        print(f"Working HEAD: {actual}")
        print(f"Journal: {self.journal_path}")
        if self.args.worksheet:
            print(f"Worksheet: {self.args.worksheet} (read-only)")
        print(f"Planned: {take} TAKE, {skipped} SKIP/REVIEW "
              f"({len(plan.order)} ordered entries)")

        if not self.journal_path.is_file():
            print("Status: NOT STARTED (no execution journal)")
            print(f"Recorded: 0 applied, 0 already present, "
                  f"0 policy skipped; {take} TAKE pending")
            if actual != plan.baseline:
                print("WARNING: working HEAD does not match the plan baseline; "
                      "new execution would be refused")
                return 2
            if not self.work_git.status_clean():
                print("WARNING: working tree is not clean")
                return 2
            return 0

        try:
            journal = json.loads(self.journal_path.read_text())
        except (OSError, ValueError) as exc:
            raise KBError(f"cannot read status journal: {exc}") from exc
        self._validate_journal(journal)
        entries = journal["entries"]
        cursor = journal["cursor"]
        blocked = journal.get("blocked")
        recorded = journal["last_head"]

        applied = sum(e["status"] in ("APPLIED", "APPLIED_MANUALLY")
                      for e in entries)
        present = sum(e["status"] == "ALREADY_PRESENT" for e in entries)
        policy = sum(e["status"] == "SKIPPED_POLICY" for e in entries)
        remaining = sum(plan.commits[sha]["advisor_decision"] == "TAKE"
                        for sha in plan.order[cursor:])
        print(f"Journal cursor: {cursor}/{len(plan.order)}")
        print(f"Recorded: {applied} applied, {present} already present, "
              f"{policy} policy skipped; {remaining} TAKE pending")
        print(f"Journal HEAD: {recorded}")
        recent = [entry for entry in entries
                  if entry["status"] in ("APPLIED", "APPLIED_MANUALLY")]
        if recent:
            print("Recent recorded applications:")
            for entry in recent[-6:]:
                sha = entry["sha"]
                downstream = entry["downstream_sha"]
                print(f"  {sha[:12]} -> {downstream[:12]} "
                      f"{plan.commits[sha].get('subject', '')}")
        if blocked:
            print(f"Blocked: {blocked['sha'][:12]}: "
                  f"{blocked.get('reason', 'unknown reason')}")
        next_take = next(
            (sha for sha in plan.order[cursor:]
             if plan.commits[sha]["advisor_decision"] == "TAKE"), None)
        if next_take:
            print(f"Next TAKE: {next_take[:12]} "
                  f"{plan.commits[next_take].get('subject', '')}")

        if actual != recorded:
            if self.work_git.is_ancestor(recorded, actual):
                print("Status: HEAD ADVANCED beyond journal "
                      "(manual reconciliation required)")
            else:
                print("Status: DIVERGED; recorded backports are NOT "
                      "verified on the current HEAD")
                if actual == plan.baseline:
                    print("Git is at the plan baseline, consistent with a "
                          "hard reset; the old journal still records work")
            print("Execution cannot continue with a divergent journal. "
                  "Investigate Git and archive the stale journal explicitly "
                  "before replaying from the baseline.")
            return 2
        if not self.work_git.status_clean():
            print("Status: DIRTY WORKTREE (journal HEAD matches, "
                  "but execution cannot continue)")
            return 2
        print("Status: BLOCKED" if blocked else "Status: IN SYNC")
        return 0

    def _present(self, sha: str, applied: set[str]) -> bool:
        if sha in applied:
            return True
        if self.work_index.match_aliases([sha]).present:
            return True
        # Check direct upstream ancestry, including cases where upstream commits
        # were merged into the downstream repository without provenance trailers.
        if (self.work_git.ok(["cat-file", "-e", f"{sha}^{{commit}}"])
                and self.work_git.is_ancestor(sha, "HEAD")):
            return True
        return False

    def _blockers(self, sha: str, applied: set[str]) -> list[str]:
        blockers = []
        for item in self.batch_plan.commits[sha].get("advisor_prerequisites", []):
            dependency = item["sha"]
            if self._present(dependency, applied):
                continue
            # A prerequisite marked present in the planner is based on the frozen
            # downstream baseline; it must still be verified from Git history.
            blockers.append(dependency)
        return list(dict.fromkeys(blockers))

    def _pick(self, git: Git, sha: str) -> tuple[bool, str, list[str]]:
        git.run(["fetch", "--no-tags", str(self.refs.upstream_path), sha])
        result = git._run_cp(["cherry-pick", "--no-commit", sha], check=False)
        if result.returncode:
            files = git.run(["diff", "--name-only", "--diff-filter=U"], check=False).splitlines()
            return False, (result.stderr or result.stdout).strip(), files
        # An empty cherry-pick needs investigation (e.g. applied independently);
        # do not create empty downstream commits or silently mark it successful.
        if git.ok(["diff", "--cached", "--quiet"]):
            return False, "cherry-pick yielded no staged changes", []
        return True, "", []

    def _sim_commit(self, git: Git, sha: str) -> None:
        git.run(["-c", "user.name=kernel-backporter", "-c", "user.email=kernel-backporter@example.invalid",
                 "-c", "core.hooksPath=/dev/null", "commit", "-m", f"preflight {sha}"])

    def _real_commit(self, sha: str) -> str:
        msg = self.commit_message(sha)
        with tempfile.NamedTemporaryFile("w", delete=False, prefix="kernel-backporter-msg-") as tf:
            tf.write(msg)
            msg_path = Path(tf.name)
        try:
            self.work_git.run(["commit", "-F", str(msg_path)])
        finally:
            msg_path.unlink(missing_ok=True)
        return self.work_git.rev_parse("HEAD")

    def run(self) -> int:
        self.prepare_plan()
        count = 0
        applied: set[str] = {
            e["sha"] for e in self.journal["entries"]
            if e.get("status") in ("APPLIED", "APPLIED_MANUALLY", "ALREADY_PRESENT")
        }
        # A single cumulative sandbox represents the evolving downstream tree.
        # This also makes --dry-run meaningful across multiple commits.
        root, simulation = self._simulation_clone()
        cursor = self.journal["cursor"]
        initial_head = self.work_git.rev_parse("HEAD")
        try:
            for position in range(cursor, len(self.batch_plan.order)):
                sha = self.batch_plan.order[position]
                rec = self.batch_plan.commits[sha]
                decision = rec["advisor_decision"]
                if decision != "TAKE":
                    print(f"SKIP {sha[:12]}: advisor {decision}")
                    if not self.args.dry_run:
                        self._append(sha, "SKIPPED_POLICY", advisor_decision=decision)
                        self._write_journal()
                    continue
                if self._present(sha, applied):
                    print(f"PRESENT {sha[:12]}: upstream identity already downstream")
                    applied.add(sha)
                    if not self.args.dry_run:
                        self._append(sha, "ALREADY_PRESENT")
                        self._write_journal()
                    continue
                if count >= self.args.max_attempts:
                    break
                count += 1
                blockers = self._blockers(sha, applied)
                if blockers:
                    reason = "unresolved advisor prerequisite(s): " + ", ".join(blockers)
                    return self._stop(sha, reason, [], count)
                if len(self.upstream.parents(sha)) != 1:
                    return self._stop(sha, "not a single-parent upstream commit", [], count)
                if not self.upstream.is_ancestor(sha, self.target):
                    return self._stop(sha, "upstream commit not reachable from plan target", [], count)
                ok, details, files = self._pick(simulation, sha)
                if not ok:
                    return self._stop(sha, "preflight failed: " + details, files, count)
                self._sim_commit(simulation, sha)
                if self.args.dry_run:
                    print(f"PREFLIGHT OK {sha[:12]} {rec.get('subject', '')}")
                    applied.add(sha)
                    continue
                # Preserve actual working tree invariant, even if an external
                # process changed it between preflight and application.
                if self.work_git.rev_parse("HEAD") != self.journal["last_head"] or not self.work_git.status_clean():
                    return self._stop(sha, "working tree/HEAD changed during preflight", [], count)
                ok, details, files = self._pick(self.work_git, sha)
                if not ok:
                    return self._stop(sha, "unexpected real-tree cherry-pick failure: " + details,
                                      files, count)
                # A preflighted cherry-pick and actual cherry-pick must have the
                # same tree before committing. This protects against drift.
                if self.work_git.run(["write-tree"]).strip() != simulation.run(["rev-parse", "HEAD^{tree}"]).strip():
                    return self._stop(sha, "preflight and real working trees differ", [], count)
                new_sha = self._real_commit(sha)
                self.journal["last_head"] = new_sha
                self._append(sha, "APPLIED", downstream_sha=new_sha)
                self.journal["blocked"] = None
                self._write_journal()
                applied.add(sha)
                print(f"APPLIED {sha[:12]} -> {new_sha[:12]} {rec.get('subject', '')}")
            if self.args.dry_run:
                if self.work_git.rev_parse("HEAD") != initial_head or not self.work_git.status_clean():
                    raise KBError("dry run unexpectedly changed working repository")
                print(f"Dry run: {count} TAKE attempt(s) preflighted; no working-tree changes")
            else:
                self.journal["blocked"] = None
                self._write_journal()
                print(f"Batch completed: {count} TAKE attempt(s); journal: {self.journal_path}")
            return 0
        finally:
            shutil.rmtree(root, ignore_errors=True)
            if not self.args.dry_run and self.text_progress is not None:
                # Use the original text and journal, including blocked status.
                snapshot = self.text_progress.write_to(
                    self.progress_output, self.batch_plan, self.journal)
                print(f"Text plan progress: {snapshot}")

    def _plan_conflict_dossier(self, sha: str, reason: str, files: list[str]) -> Path:
        """Save a self-contained manual inspection packet without editing source."""
        import hashlib

        root = self.state_dir / "conflicts" / sha
        root.mkdir(parents=True, exist_ok=True)
        (root / "upstream.patch").write_text(self.upstream.run(["show", sha]))
        (root / "summary.json").write_text(json.dumps({
            "upstream_sha": sha,
            "subject": self.subject(sha),
            "working_head": self.work_git.rev_parse("HEAD"),
            "reason": reason,
            "files": files,
            "advisor_rationale": self.batch_plan.commits[sha].get("advisor_rationale"),
            "advisor_prerequisites": self.batch_plan.commits[sha].get("advisor_prerequisites", []),
        }, indent=2, sort_keys=True) + "\n")
        parents = self.upstream.parents(sha)
        for path in files[:20]:
            safe = hashlib.sha256(path.encode()).hexdigest()[:12] + "-" + Path(path).name
            dest = root / safe
            dest.mkdir(exist_ok=True)
            for filename, git, revision in [
                ("upstream-before", self.upstream, parents[0] if len(parents) == 1 else None),
                ("upstream-after", self.upstream, sha),
                ("downstream-HEAD", self.work_git, "HEAD"),
            ]:
                if revision:
                    (dest / filename).write_text(
                        git.run(["show", f"{revision}:{path}"], check=False)[:262144]
                    )
        return root

    def _stop(self, sha: str, reason: str, files: list[str], count: int) -> int:
        print(f"STOP at {sha[:12]} after {count} attempt(s): {reason}")
        if files:
            print("Conflicted files: " + ", ".join(files))
        dossier = None
        if reason.startswith("preflight failed:") or reason.startswith("unexpected real-tree cherry-pick failure:"):
            dossier = self._plan_conflict_dossier(sha, reason, files)
            print(f"Conflict dossier: {dossier}")
        if not self.args.dry_run:
            self.journal["blocked"] = {
                "sha": sha, "reason": reason, "files": files,
                "dossier": str(dossier) if dossier else None,
            }
            self._write_journal()
        print("No additional upstream prerequisites were imported automatically.")
        return 2

def parse_args(argv: Sequence[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Dependency-aware Linux kernel backport orchestrator",
        epilog=textwrap.dedent(
            """\
            Familiar usage:
              kernel-backporter -l stable -j RHEL-223619 -c 35c3dcb1ac2c

            Safe first test:
              kernel-backporter -l stable -j RHEL-223619 -c 35c3dcb1ac2c \\
                  --dry-run

            The tool never edits conflicted source automatically.  It only retries
            by adding known upstream commits and stops when manual source resolution
            is still required.
            """
        ),
    )
    p.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    mode = p.add_mutually_exclusive_group()
    mode.add_argument("-c", "--commit", help="upstream commit SHA for single-commit mode")
    mode.add_argument("--plan", help="explicit planner JSON for bounded TAKE batches")
    mode.add_argument("--results-dir", help="explicit planning cycle directory; "
                      "default is latest completed run under "
                      "$KERNEL_WORKSPACE_DIR/backport-plans")
    p.add_argument("-j", "--jira", help="Jira ID, e.g. RHEL-223619")
    p.add_argument("--status", action="store_true",
                   help="read-only plan progress and Git/journal consistency")
    p.add_argument("-l", "--linux-repo", choices=("stable", "next"), default="stable")
    p.add_argument("--target", help="optional upstream analysis boundary in single-commit mode "
                   "(default: upstream origin/HEAD; fallback: HEAD); "
                   "plan mode uses its JSON target")
    p.add_argument("--max-attempts", type=int, default=1,
                   help="max TAKE commits attempted per plan invocation (default: 1)")
    p.add_argument("--journal", help="override plan execution journal location")
    p.add_argument("--worksheet", help="editable worksheet for an explicit --plan "
                   "(updated in place; preserves engineer annotations)")
    p.add_argument("--text-plan", help="legacy source for --progress-output snapshots")
    p.add_argument("--progress-output", help="user-chosen progress filename; never overwrite")
    p.add_argument(
        "--repo",
        help="downstream working repository (default: "
             "$KERNEL_WORKSPACE_DIR/centos-stream-$CS_VERSION; "
             "fallback: $KERNEL_SRC_DIR, then current directory)",
    )
    p.add_argument(
        "--reference-root",
        default=default_reference_root(),
        help=(
            "tool-managed reference repositories "
            "(default: $KERNEL_BACKPORTER_REFERENCE_ROOT, then "
            "$XDG_CACHE_HOME/kernel-backporter/reference, then "
            "~/.cache/kernel-backporter/reference)"
        ),
    )
    p.add_argument("--upstream-url", help="override upstream reference clone URL")
    p.add_argument("--downstream-url", help="override current downstream/CS10 clone URL")
    p.add_argument("--downstream-remote", default="cs10",
                   help="working-tree remote used to discover downstream URL (default: cs10)")
    p.add_argument("--downstream-branch", default="main")
    p.add_argument("--skip-refresh", action="store_true",
                   help="do not fetch/update reference repositories (normally CS10 is refreshed every run)")
    p.add_argument("--dry-run", action="store_true",
                   help="perform orchestration/preflight and reports but do not modify the real working tree")
    p.add_argument("--no-patch-id", action="store_true",
                   help="disable stable patch-id fallback when downstream provenance is absent")
    p.add_argument("--series", action=argparse.BooleanOptionalAction, default=True,
                   help="report inferred peers from the original lore-linked patch series")
    p.add_argument("--check-command",
                   help="optional build/test shell command run after a clean simulated sequence")
    p.add_argument("--context-lines", type=int, default=3)
    p.add_argument("--max-symbols", type=int, default=40)
    p.add_argument("--max-rounds", type=int, default=12,
                   help="maximum dependency-discovery/replay rounds")
    p.add_argument("--max-later-context", type=int, default=12)
    p.add_argument("--max-merge-risks", type=int, default=10)
    p.add_argument("--report-dir", default="~/backports/kernel-backporter")
    p.add_argument("--diff-dir", default="~/backport_commit_diffs")
    p.add_argument("--patch-dir", default="~/",
                   help="directory for downstream format-patch files")
    p.add_argument("--jira-url", default="https://issues.redhat.com/browse")
    p.add_argument("--signoff-name")
    p.add_argument("--signoff-email")
    p.add_argument("--debug", action="store_true")
    args = p.parse_args(argv)
    # Explicit -c, --plan and --results-dir always override discovery.
    args.auto_selected = False
    # Prefer the shared workspace over the obsolete per-plan variable, so a
    # stale shell export cannot silently pin a previous run.
    if not (args.plan or args.commit or args.results_dir):
        workspace = os.environ.get("KERNEL_WORKSPACE_DIR")
        if workspace:
            try:
                args.results_dir = str(latest_completed_plan_directory(workspace))
                args.auto_selected = True
            except KBError as exc:
                p.error(str(exc))
        else:
            args.results_dir = os.environ.get("KERNEL_BACKPORT_PLANNER_DIR")
        if not args.results_dir:
            p.error("specify -c, --plan, --results-dir, or set "
                    "KERNEL_WORKSPACE_DIR")
    if args.results_dir:
        directory = Path(args.results_dir).expanduser().resolve()
        if not directory.is_dir():
            p.error(f"planning results directory does not exist: {directory}")
        plan = directory / "backport_plan.json"
        worksheet = directory / "backport_worksheet.txt"
        for path in (plan, worksheet):
            if path.is_symlink() or not path.is_file():
                p.error(f"planning result is missing or a symlink: {path}")
        if args.worksheet:
            p.error("--worksheet cannot override the standard --results-dir worksheet")
        args.plan = str(plan)
        args.worksheet = str(worksheet)
        args.results_dir = str(directory)
    if not args.status and not args.jira:
        p.error("-j/--jira is required except with --status")
    if args.status:
        if not args.plan:
            p.error("--status requires --plan")
        if (args.dry_run or args.progress_output
                or args.text_plan or args.check_command
                or args.max_attempts != 1):
            p.error("--status is read-only; cannot combine with "
                    "--dry-run, --progress-output, --text-plan, "
                    "--check-command, or --max-attempts")
    if args.max_attempts < 1:
        p.error("--max-attempts must be at least 1")
    if not args.plan and (args.journal or args.text_plan or
                          args.progress_output or args.worksheet or
                          args.max_attempts != 1):
        p.error("plan execution flags require --plan or --results-dir")
    if args.worksheet and args.progress_output:
        p.error("--worksheet cannot be combined with --progress-output")
    if args.text_plan and not args.progress_output:
        p.error("--text-plan requires --progress-output")
    if args.dry_run and args.progress_output:
        p.error("--progress-output is not available with --dry-run")
    return args


def main(argv: Sequence[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    print(f"{Path(sys.argv[0]).name} {VERSION}")
    if args.results_dir:
        print(f"Planning cycle: {args.results_dir}")
    if args.plan:
        # A missing --target is resolved by the validated plan after loading.
        if args.target is None:
            args.target = BackportPlan.load(args.plan).target
        executor = PlannedBackporter(args)
        return executor.status() if args.status else executor.run()
    return KernelBackporter(args).run()


def cli(argv: Sequence[str] | None = None) -> int:
    """CLI entry point with one best-effort notification per actual run.

    Read-only status, help, version and argument-validation errors remain
    silent. Normal plan/single-commit runs, including dry runs, signal the
    actual result. The library-facing main() stays silent for tests/imports.
    """
    args = list(sys.argv[1:] if argv is None else argv)
    notify = not any(arg in ("--status", "--version", "-h", "--help")
                     for arg in args)
    try:
        result = main(args)
    except KeyboardInterrupt:
        print("kernel-backporter: interrupted", file=sys.stderr)
        if notify:
            play_backporter_completion_sound(False)
        return 130
    except KBError as exc:
        print(f"kernel-backporter: {exc}", file=sys.stderr)
        if notify:
            play_backporter_completion_sound(False)
        return 1
    # argparse SystemExit (including invalid options) is handled by the usual
    # CLI mechanism and does not count as a completed backport attempt.
    if notify:
        play_backporter_completion_sound(result == 0)
    return result


if __name__ == "__main__":
    raise SystemExit(cli())
