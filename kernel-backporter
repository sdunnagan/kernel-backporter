VERSION = "0.2.7"


HEX40 = r"[0-9a-fA-F]{40}"
CHERRY_PICK_RE = re.compile(rf"(?im)^\s*\(cherry picked from commit ({HEX40})\)\s*$")
UPSTREAM_COMMIT_RE = re.compile(rf"(?im)^\s*Upstream commit\s+({HEX40})\b")
STABLE_UPSTREAM_RE = re.compile(rf"(?im)^\s*commit\s+({HEX40})\s+upstream\.?\s*$")
EMBEDDED_COMMIT_RE = re.compile(rf"(?im)^\s*commit\s+({HEX40})\s*$")
FIXES_RE = re.compile(r"(?im)^Fixes:\s*([0-9a-f]{7,40})\b")
LINK_RE = re.compile(r"(?im)^Link:\s*(https?://\S+)")
LORE_MSGID_RE = re.compile(r"https?://lore\.kernel\.org/[^/]+/(?:r/)?([^/\s>]+)")
SERIES_MSGID_RE = re.compile(r"^(?P<stem>.+)-(?P<num>\d+)-(?P<tail>[^@]+@.+)$")
DIFF_FILE_RE = re.compile(r"^diff --git a/(.+?) b/(.+)$")
HUNK_RE = re.compile(r"^@@\s+-(\d+)(?:,(\d+))?\s+\+(\d+)(?:,(\d+))?\s+@@")
FUNC_CALL_RE = re.compile(r"\b([A-Za-z_][A-Za-z0-9_]*)\s*\(")
MACRO_RE = re.compile(r"\b([A-Z][A-Z0-9_]{3,})\b")
BUILD_SYMBOL_RES = [
    re.compile(r"implicit declaration of function [‘'`](?P<sym>[A-Za-z_][A-Za-z0-9_]*)"),
    re.compile(r"undefined reference to [‘'`](?P<sym>[A-Za-z_][A-Za-z0-9_]*)"),
    re.compile(r"[‘'`](?P<sym>[A-Za-z_][A-Za-z0-9_]*)[’'`] undeclared"),
]

