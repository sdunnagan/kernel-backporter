def stdout_uses_color() -> bool:
    """Return whether human-facing stdout should use ANSI color."""
    if "NO_COLOR" in os.environ:
        return False
    if os.environ.get("TERM", "").lower() == "dumb":
        return False
    return sys.stdout.isatty()


def color_stdout(text: str, *codes: str) -> str:
    """Color text for an interactive terminal, leaving redirected output plain."""
    if not codes or not stdout_uses_color():
        return text
    return "".join(codes) + text + ANSI_RESET


def default_reference_root() -> str:
    """Return the default location for tool-managed reference repositories."""
    override = os.environ.get("KERNEL_BACKPORTER_REFERENCE_ROOT")
    if override:
        return override

    cache_home = os.environ.get("XDG_CACHE_HOME")
    if cache_home:
        cache_path = Path(cache_home).expanduser()
        if cache_path.is_absolute():
            return str(cache_path / "kernel-backporter" / "reference")

    return str(Path.home() / ".cache" / "kernel-backporter" / "reference")


class KBError(RuntimeError):
    pass


# Kernel-builder and kernel-backport-planner use these Freedesktop sounds too.
# Audio notification is deliberately best-effort and never affects exit status.
BACKPORTER_SOUND_DIR = "/usr/share/sounds/freedesktop/stereo"


def play_backporter_completion_sound(success: bool) -> None:
    """Play a single completion/failure sound for an execution attempt."""
    filename = "complete.oga" if success else "service-logout.oga"
    directory = os.environ.get("KBB_SOUND_DIR", BACKPORTER_SOUND_DIR)
    sound = Path(directory).expanduser() / filename
    try:
        if not sound.is_file():
            return
        for player, options in (
            ("canberra-gtk-play", ["-f", str(sound)]),
            ("pw-play", [str(sound)]),
            ("paplay", [str(sound)]),
        ):
            program = shutil.which(player)
            if not program:
                continue
            try:
                result = subprocess.run(
                    [program, *options], stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL, timeout=10, check=False,
                )
                if result.returncode == 0:
                    return
            except (OSError, subprocess.TimeoutExpired):
                continue
    except OSError:
        pass


def latest_completed_plan_directory(workspace: str | Path) -> Path:
    """Select the highest-numbered completed planning cycle in a workspace.

    A sibling ZIP is the planner's completion marker. Incomplete higher
    numbered runs are skipped; neither a partial JSON nor a worksheet alone
    is sufficient. Never choose a plan by modification time or lexical order.
    """
    root = Path(workspace).expanduser().resolve()
    directory = root / "backport-plans"
    if not directory.is_dir() or directory.is_symlink():
        raise KBError(f"no planner results directory: {directory}")
    candidates: list[tuple[int, Path]] = []
    for child in directory.iterdir():
        match = re.fullmatch(r"backport_plan_(\d+)", child.name)
        if match and child.is_dir() and not child.is_symlink():
            candidates.append((int(match.group(1)), child))
    candidates.sort(key=lambda item: item[0], reverse=True)
    for _, child in candidates:
        plan = child / "backport_plan.json"
        worksheet = child / "backport_worksheet.txt"
        archive = child.with_suffix(".zip")
        if not all(path.is_file() and not path.is_symlink()
                   for path in (plan, worksheet, archive)):
            continue
        try:
            # Opening the archive's central directory is cheap even when it
            # contains a large advisor trace. No decompression is necessary.
            with zipfile.ZipFile(archive) as zipped:
                zipped.getinfo(f"{child.name}/backport_plan.json")
                zipped.getinfo(f"{child.name}/backport_worksheet.txt")
            with plan.open("r", encoding="utf-8") as stream:
                if not isinstance(json.load(stream), dict):
                    continue
        except (OSError, ValueError, KeyError, zipfile.BadZipFile):
            continue
        return child.resolve()
    raise KBError(
        f"no completed planner run in {directory}; expected "
        "backport_plan_N/backport_plan.json, backport_worksheet.txt, "
        "and the sibling backport_plan_N.zip. Use --results-dir to "
        "select a nonstandard or older plan explicitly."
    )


def default_downstream_repo() -> str:
    """Derive the normal kernel source directory from the shared workspace."""
    workspace = os.environ.get("KERNEL_WORKSPACE_DIR")
    if workspace:
        root = Path(workspace).expanduser().resolve()
        cs_version = os.environ.get("CS_VERSION")
        if cs_version:
            return str(root / f"centos-stream-{cs_version}")
        matches = sorted(path for path in root.glob("centos-stream-*")
                         if path.is_dir())
        if len(matches) == 1:
            return str(matches[0])
        if len(matches) > 1:
            raise KBError(
                f"multiple CentOS Stream trees under {root}; set "
                "CS_VERSION or use --repo"
            )
    return os.environ.get("KERNEL_SRC_DIR") or "."


class Git:
    def __init__(self, cwd: Path, debug: bool = False):
        self.cwd = cwd
        self.debug = debug

    def _run_cp(
        self,
        args: Sequence[str],
        *,
        check: bool = True,
        input_text: str | None = None,
        cwd: Path | None = None,
        stdout=None,
        stderr=None,
        env: dict[str, str] | None = None,
    ) -> subprocess.CompletedProcess:
        cmd = ["git", *args]
        if self.debug:
            print("+", shlex.join(cmd), file=sys.stderr)
        cp = subprocess.run(
            cmd,
            cwd=str(cwd or self.cwd),
            input=input_text,
            text=True,
            encoding="utf-8",
            errors="replace",
            stdout=subprocess.PIPE if stdout is None else stdout,
            stderr=subprocess.PIPE if stderr is None else stderr,
            env=env,
        )
        if check and cp.returncode:
            serr = cp.stderr if isinstance(cp.stderr, str) else ""
            raise KBError(
                f"command failed ({cp.returncode}): {shlex.join(cmd)}\n{serr.strip()}"
            )
        return cp

    def run(
        self,
        args: Sequence[str],
        *,
        check: bool = True,
        input_text: str | None = None,
        cwd: Path | None = None,
        env: dict[str, str] | None = None,
    ) -> str:
        return self._run_cp(
            args, check=check, input_text=input_text, cwd=cwd, env=env
        ).stdout

    def ok(self, args: Sequence[str], *, cwd: Path | None = None) -> bool:
        cp = subprocess.run(
            ["git", *args], cwd=str(cwd or self.cwd),
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        return cp.returncode == 0

    def rev_parse(self, obj: str) -> str:
        return self.run(["rev-parse", "--verify", f"{obj}^{{commit}}"]).strip()

    def subject(self, sha: str) -> str:
        return self.run(["show", "-s", "--format=%s", sha]).strip()

    def body(self, sha: str) -> str:
        return self.run(["show", "-s", "--format=%B", sha])

    def medium_header(self, sha: str) -> str:
        return self.run(["show", "--no-patch", "--format=medium", sha]).rstrip()

    def parents(self, sha: str) -> list[str]:
        return self.run(["show", "-s", "--format=%P", sha]).strip().split()

    def changed_files(self, sha: str) -> list[str]:
        return [x for x in self.run([
            "diff-tree", "--no-commit-id", "--name-only", "-r", sha
        ]).splitlines() if x]

    def is_ancestor(self, older: str, newer: str) -> bool:
        return self.ok(["merge-base", "--is-ancestor", older, newer])

    def remotes(self) -> set[str]:
        return {x.strip() for x in self.run(["remote"]).splitlines() if x.strip()}

    def remote_url(self, remote: str) -> str | None:
        if remote not in self.remotes():
            return None
        out = self.run(["remote", "get-url", remote], check=False).strip()
        return out or None

    def status_clean(self) -> bool:
        return not self.run(["status", "--porcelain=v1"]).strip()


