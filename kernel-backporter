def stdout_uses_color() -> bool:
    """Return whether human-facing stdout should use ANSI color."""
    if "NO_COLOR" in os.environ:
        return False
    if os.environ.get("TERM", "").lower() == "dumb":
        return False
    return sys.stdout.isatty()


def color_stdout(text: str, *codes: str) -> str:
    """Color text for an interactive terminal, leaving redirected output plain."""
    if not codes or not stdout_uses_color():
        return text
    return "".join(codes) + text + ANSI_RESET


class KBError(RuntimeError):
    pass


class Git:
    def __init__(self, cwd: Path, debug: bool = False):
        self.cwd = cwd
        self.debug = debug

    def _run_cp(
        self,
        args: Sequence[str],
        *,
        check: bool = True,
        input_text: str | None = None,
        cwd: Path | None = None,
        stdout=None,
        stderr=None,
        env: dict[str, str] | None = None,
    ) -> subprocess.CompletedProcess:
        cmd = ["git", *args]
        if self.debug:
            print("+", shlex.join(cmd), file=sys.stderr)
        cp = subprocess.run(
            cmd,
            cwd=str(cwd or self.cwd),
            input=input_text,
            text=True,
            encoding="utf-8",
            errors="replace",
            stdout=subprocess.PIPE if stdout is None else stdout,
            stderr=subprocess.PIPE if stderr is None else stderr,
            env=env,
        )
        if check and cp.returncode:
            serr = cp.stderr if isinstance(cp.stderr, str) else ""
            raise KBError(
                f"command failed ({cp.returncode}): {shlex.join(cmd)}\n{serr.strip()}"
            )
        return cp

    def run(
        self,
        args: Sequence[str],
        *,
        check: bool = True,
        input_text: str | None = None,
        cwd: Path | None = None,
        env: dict[str, str] | None = None,
    ) -> str:
        return self._run_cp(
            args, check=check, input_text=input_text, cwd=cwd, env=env
        ).stdout

    def ok(self, args: Sequence[str], *, cwd: Path | None = None) -> bool:
        cp = subprocess.run(
            ["git", *args], cwd=str(cwd or self.cwd),
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        return cp.returncode == 0

    def rev_parse(self, obj: str) -> str:
        return self.run(["rev-parse", "--verify", f"{obj}^{{commit}}"]).strip()

    def subject(self, sha: str) -> str:
        return self.run(["show", "-s", "--format=%s", sha]).strip()

    def body(self, sha: str) -> str:
        return self.run(["show", "-s", "--format=%B", sha])

    def medium_header(self, sha: str) -> str:
        return self.run(["show", "--no-patch", "--format=medium", sha]).rstrip()

    def parents(self, sha: str) -> list[str]:
        return self.run(["show", "-s", "--format=%P", sha]).strip().split()

    def changed_files(self, sha: str) -> list[str]:
        return [x for x in self.run([
            "diff-tree", "--no-commit-id", "--name-only", "-r", sha
        ]).splitlines() if x]

    def is_ancestor(self, older: str, newer: str) -> bool:
        return self.ok(["merge-base", "--is-ancestor", older, newer])

    def remotes(self) -> set[str]:
        return {x.strip() for x in self.run(["remote"]).splitlines() if x.strip()}

    def remote_url(self, remote: str) -> str | None:
        if remote not in self.remotes():
            return None
        out = self.run(["remote", "get-url", remote], check=False).strip()
        return out or None

    def status_clean(self) -> bool:
        return not self.run(["status", "--porcelain=v1"]).strip()


